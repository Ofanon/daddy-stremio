FROM node:22-alpine AS build
WORKDIR /app
COPY --from=resolver_source / ./
COPY configure-resolver.mjs /tmp/configure-resolver.mjs
RUN node /tmp/configure-resolver.mjs && npm ci --ignore-scripts && npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3000
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/package.json ./
USER node
EXPOSE 3000
CMD ["node", "dist/api/index.js"]
